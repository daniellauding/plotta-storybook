{
  "name": "@plotta/components-native",
  "version": "0.1.0",
  "description": "React Native components for Plotta design system",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.tsx",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "react-native": "./src/index.tsx"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --format cjs,esm --dts --external react --external react-native",
    "dev": "tsup src/index.tsx --format cjs,esm --dts --external react --external react-native --watch",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "react-native",
    "components",
    "design-system",
    "ui"
  ],
  "author": "Daniel Lauding",
  "license": "MIT",
  "dependencies": {
    "@plotta/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.70.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.48",
    "react": "^19.1.0",
    "react-native": "0.81.5",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  }
}
