{
  "name": "@plotta/components-web",
  "version": "0.1.0",
  "description": "React components for Plotta design system (web)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --format cjs,esm --dts --external react --external react-dom",
    "dev": "tsup src/index.tsx --format cjs,esm --dts --external react --external react-dom --watch",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "ui"
  ],
  "author": "Daniel Lauding",
  "license": "MIT",
  "dependencies": {
    "@plotta/tokens": "workspace:*",
    "@plotta/utils": "workspace:*",
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  }
}
